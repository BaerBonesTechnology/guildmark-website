# Firebase / Cloud Run environment template. No billing or deployments occur locally.
FIREBASE_PROJECT_ID=demo-guildmark
AUTH_MODE=firebase-emulator
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=GuildMark Local
FIRESTORE_DATABASE_ID=(default)
FIREBASE_STORAGE_BUCKET=demo-guildmark.firebasestorage.app
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
PUBLIC_API_PREFIX=/api
API_PORT=8080
JWT_ACCESS_SECRET=local-only-change-before-deployment
JWT_REFRESH_SECRET=local-only-change-before-deployment
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
CORS_ORIGIN=http://localhost:5173
ADMIN_CORS_ORIGIN=http://localhost:3001
PARTNER_CORS_ORIGIN=http://localhost:3002
GM_DEBUG=false
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
