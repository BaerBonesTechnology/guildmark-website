# Copy to .env for Compose, or configure these in Doppler. Never commit secrets.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# Prefer the regional endpoint shown in your Cloud project's settings.
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
CORS_ORIGIN=https://guildmark.co
ADMIN_CORS_ORIGIN=https://devdash.guildmark.co
PARTNER_CORS_ORIGIN=https://partner.guildmark.co
GM_DEBUG=false
# Required at API startup; use real sandbox credentials for development.
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
# Public build-time values for each Cloudflare Pages project:
VITE_API_URL=https://api.guildmark.co
ADMIN_VITE_API_URL=https://api.guildmark.co
